{
  "id": "cover.factory",
  "name": "封面工厂",
  "version": "0.4.12",
  "sdkVersion": "2",
  "author": "W佬",
  "description": "复用 FrameBase 的 Pillow 封面渲染核心，从本地授权目录素材图片生成 Emby 封面（九宫格/堆叠/海报墙等多种布局），并可通过 Emby API 上传到目标条目。",
  "entry": "plugin.py:Plugin",
  "permissions": [
    "emby.api",
    "files.read",
    "storage"
  ],
  "config": [
    {
      "key": "embyUrl",
      "label": "Emby 地址（直连取图，如 http://192.168.1.10:8096）",
      "type": "text",
      "default": ""
    },
    {
      "key": "embyApiKey",
      "label": "Emby API Key（Emby 后台 → 设置 → 高级 → API 密钥 → 新建）",
      "type": "text",
      "default": ""
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "embyUrl": {
        "type": "string"
      },
      "embyApiKey": {
        "type": "string"
      }
    }
  },
  "actions": [
    {
      "id": "load-libraries",
      "label": "加载媒体库",
      "fields": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "outputSchema": {}
    },
    {
      "id": "load-items",
      "label": "加载条目",
      "fields": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "outputSchema": {}
    },
    {
      "id": "save-settings",
      "label": "保存当前设置",
      "fields": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "outputSchema": {}
    },
    {
      "id": "generate-cover",
      "label": "生成封面",
      "fields": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "serverId": {},
          "libraryId": {},
          "sourceMode": {
            "type": "string",
            "enum": ["random", "latest", "premiere"]
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "titleSize": {
            "type": "integer"
          },
          "subtitleSize": {
            "type": "integer"
          },
          "embyUrl": {
            "type": "string"
          },
          "embyApiKey": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "upload": {
            "type": "boolean"
          },
          "fontTitle": {
            "type": "string"
          },
          "fontSubtitle": {
            "type": "string"
          },
          "fontCount": {
            "type": "string"
          },
          "titleColor": {
            "type": "string"
          },
          "subtitleColor": {
            "type": "string"
          },
          "badgeStyle": {
            "type": "string"
          },
          "badgeFont": {
            "type": "string"
          },
          "badgeTextColor": {
            "type": "string"
          },
          "badgeBgColor": {
            "type": "string"
          },
          "badgeSize": {
            "type": "integer"
          },
          "badgeOpacity": {
            "type": "integer"
          },
          "badgeBorderOpacity": {
            "type": "integer"
          },
          "titleOffsetY": {
            "type": "integer"
          },
          "subtitleOffsetY": {
            "type": "integer"
          },
          "posterCount": {
            "type": "integer"
          },
          "blurRadius": {
            "type": "integer"
          },
          "bgDarkness": {
            "type": "integer"
          },
          "bgBlur": {
            "type": "integer"
          },
          "fanRadius": {
            "type": "integer"
          },
          "fanSpread": {
            "type": "integer"
          },
          "layoutYOffset": {
            "type": "integer"
          },
          "badgeXPercent": {
            "type": "number"
          },
          "badgeYPercent": {
            "type": "number"
          },
          "brightness": {
            "type": "number"
          },
          "centerScale": {
            "type": "number"
          },
          "sideScaleShrink": {
            "type": "number"
          },
          "templateName": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": true
      },
      "outputSchema": {}
    },
    {
      "id": "probe-image",
      "label": "探测图片",
      "fields": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "outputSchema": {}
    },
    {
      "id": "generate-all",
      "label": "一键生成全部媒体库",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceMode": {
            "type": "string",
            "enum": ["random", "latest", "premiere"]
          },
          "layout": {
            "type": "string"
          },
          "fontTitle": {
            "type": "string"
          },
          "fontSubtitle": {
            "type": "string"
          },
          "badgeStyle": {
            "type": "string"
          },
          "badgeFont": {
            "type": "string"
          },
          "badgeSize": {
            "type": "integer"
          }
        },
        "required": [],
        "additionalProperties": true
      },
      "outputSchema": {}
    },
    {
      "id": "save-template",
      "label": "保存当前为模板",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": true
      },
      "outputSchema": {}
    }
  ],
  "queries": [
    {
      "id": "servers",
      "label": "Emby 服务器",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    },
    {
      "id": "libraries",
      "label": "媒体库",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    },
    {
      "id": "items",
      "label": "条目",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    },
    {
      "id": "preview",
      "label": "最新预览",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    },
    {
      "id": "fonts",
      "label": "内置字体",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    },
    {
      "id": "templates",
      "label": "模板",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    }
  ],
  "triggers": [],
  "ui": {
    "mode": "python",
    "version": "2"
  }
}